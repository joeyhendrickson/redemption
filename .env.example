# =============================================================================
# Redemption Home Services — Environment Variable Reference
# =============================================================================
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Storage
SUPABASE_STORAGE_BUCKET=uploads
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=uploads

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Redemption Home Services <noreply@redemptionhomeservices.com>"

# SMS (Twilio, optional — logs to console when unset)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Payments (Stripe, optional)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# AWS S3 (optional storage alternative)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-2
